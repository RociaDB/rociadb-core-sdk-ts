{
  "name": "@rocia/core-sdk",
  "version": "1.0.0",
  "description": "TypeScript client SDK for RociaDB document, graph, and file gRPC services",
  "author": "RociaDB SAS",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RociaDB/rociadb-core-sdk-ts.git"
  },
  "homepage": "https://github.com/RociaDB/rociadb-core-sdk-ts#readme",
  "bugs": {
    "url": "https://github.com/RociaDB/rociadb-core-sdk-ts/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./proto": {
      "types": "./dist/proto.d.ts",
      "import": "./dist/proto.js"
    }
  },
  "files": [
    "dist",
    "!dist/test",
    "src",
    "!src/test",
    "proto",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "rociadb",
    "database",
    "grpc",
    "sdk",
    "typescript"
  ],
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
